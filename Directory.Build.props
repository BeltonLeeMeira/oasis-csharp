<Project>
  <!-- Vale para todos os projetos da solução. A versão segue o versionamento semântico (ver CHANGELOG.md). -->
  <PropertyGroup>
    <Version>0.2.0</Version>
    <Authors>Belton Lee Carr De Muzio Meira (RM560760)</Authors>
    <Product>Oásis · Painel do Posto</Product>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Sem internet, o NuGet não consegue checar vulnerabilidades (NU1900); isso não deve quebrar o build. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
